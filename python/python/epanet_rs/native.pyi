"""Type stubs for the `epanet_rs.native` submodule: idiomatic bindings for the
native epanet-rs Rust API (`Simulation`, `Network`, ...), as opposed to the
EPANET-2.3-toolkit-mirroring `epanet_rs.Project`.
"""

from __future__ import annotations

class InputError(Exception): ...
class SolverError(Exception): ...

# --- enums (mirror the corresponding Rust enums 1:1) ---

class NodeType:
    Junction: NodeType
    Reservoir: NodeType
    Tank: NodeType

class LinkType:
    Pipe: LinkType
    Pump: LinkType
    Valve: LinkType

class ValveType:
